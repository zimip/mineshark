      "net.zimi.client.Mineshark"
    ]
  },
  "mixins": [
    {
      "config": "mineshark.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
